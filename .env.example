# Copy to .env.local and fill in. .env.local is gitignored and never committed.
# These are server-only. Do NOT add a NEXT_PUBLIC_ prefix — that would inline
# the values into the client bundle and expose them in the browser.

# The single account allowed to sign in.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=change-me

# Signs the session cookie so it can't be forged.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

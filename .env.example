# Copy to .env.local and fill in. .env.local is gitignored and never committed.
# These are server-only. Do NOT add a NEXT_PUBLIC_ prefix — that would inline
# the values into the client bundle and expose them in the browser.

# The single account allowed to sign in.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=change-me

# Signs the session cookie so it can't be forged.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Postgres connection string, read by getDb(). Not a value to invent -- it is
# provisioned by the Neon Marketplace integration and lives on Vercel. Pull it
# into a scratch file and copy this one line across:
#
#   vercel env pull --environment=development .env.scratch
#
# Pull to a scratch file rather than running a bare `vercel env pull`, which
# overwrites .env.local wholesale and drops the three variables above -- they
# exist on Vercel for Production only. See docs/environment.md.
DATABASE_URL=
